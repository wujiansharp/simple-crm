DROP TABLE IF EXISTS crm_goods;
CREATE TABLE `crm_goods` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `merchant_id` bigint DEFAULT NULL COMMENT '商铺ID',
  `goods_name` varchar(100) NOT NULL COMMENT '商品名称',
  `price` decimal(10,2) DEFAULT '0.00' COMMENT '单价',
  `create_time` datetime DEFAULT CURRENT_TIMESTAMP,
  `del_flag` int DEFAULT 1,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='商品表';

DROP TABLE IF EXISTS crm_order_goods;
CREATE TABLE `crm_order_goods` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `merchant_id` bigint DEFAULT NULL COMMENT '商铺ID',
  `order_id` bigint NOT NULL COMMENT '订单ID',
  `goods_id` bigint DEFAULT NULL COMMENT '商品ID',
  `goods_name` varchar(100) DEFAULT '' COMMENT '商品名称',
  `price` decimal(10,2) DEFAULT '0.00' COMMENT '单价',
  `num` int DEFAULT 1 COMMENT '数量',
  `total_price` decimal(10,2) DEFAULT '0.00' COMMENT '小计',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='订单商品明细表';